# MongoDB local server or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=nirmalcity

# Signs every session token. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_HOURS=24

# The account matching this email receives admin access when it signs up.
ADMIN_EMAIL=admin@example.com
# Optional first-run admin bootstrap. Set only in your local .env with a
# unique password (8-128 characters); it is hashed in MongoDB and never
# overwrites an existing account password. Use password reset to change it.
ADMIN_PASSWORD=

# Only needed when a frontend is hosted on a different origin.
CORS_ORIGINS=
PORT=5000

# Where uploaded photos are stored (relative paths anchor to the app folder).
UPLOAD_DIR=uploads

# How long a generated photo URL stays valid.
PHOTO_URL_TTL_HOURS=24

# List thumbnail size/quality (needs Pillow).
THUMB_SIZE=320
THUMB_QUALITY=82

# --- Gemini AI report verification -------------------------------------
# Get a key at https://aistudio.google.com/apikey and paste it below.
# Without a key reports are stored as "pending" and shown to admins with a
# "Review needed" badge instead of being AI-verified.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT=20
# ONLY_VERIFIED_TO_ADMIN=false

# --- Rewards (points + partner coupons) ---------------------------------
# Points paid out whenever AI verifies a report as genuine.
# REWARD_POINTS=10
# Coupon redemptions allowed per hour, per account.
# REDEEM_LIMIT=20

# --- Sign-up OTP email (Gmail SMTP) -------------------------------------
# Every new sign-up gets a unique 6-digit code, emailed with these
# credentials. Create one at: Google Account → Security → 2-Step
# Verification → App Passwords (16 digits, app "Mail"), not your login
# password.
# Leave blank for DEV MODE: the code is returned in the API response
# (dev_otp) and printed to the server log instead of being emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# OTP_EXPIRY_MINUTES=5
# OTP_RESEND_SECONDS=60
# OTP_ATTEMPTS=5
# SETUP_TOKEN_MINUTES=10

# --- Automatic coupon feed ----------------------------------------------
# Every COUPON_REFRESH_DAYS (default 4) the background scheduler re-scans
# the trusted coupon sources, re-verifies the codes it found before, adds
# fresh ones, and stales/expired-out ones that disappeared or lapsed.
# The schedule is re-checked every COUPON_FEED_CHECK_MINUTES (default 360);
# failed runs do not consume the schedule (the next check retries).
# COUPON_REFRESH_DAYS=4
# COUPON_FEED_CHECK_MINUTES=360
# COUPON_AUTO_COST=10        # points an auto-discovered coupon costs to unlock
# COUPON_AUTO_HORIZON_DAYS=30  # validity assigned when a source gives no date
# COUPON_FETCH_TIMEOUT=15    # seconds per source page
# COUPON_FETCH_DELAY=0.2     # politeness gap between source requests (seconds)
# COUPON_FEED_LIMIT=6        # admin manual refreshes per hour

# Optional rate-limit tuning (per window, per IP/account).
# AUTH_LOGIN_LIMIT=10
# AUTH_LOGIN_IP_LIMIT=30
# AUTH_SIGNUP_LIMIT=20
# REPORT_LIMIT=60
